# Docker Compose local environment example.
# Copy this file to .env and replace every change-me-before-start value.

# Docker image names. BATCH_IMAGE is used by Prefect and the batch runner.
# BATCH_IMAGE=stocksearcher-batch:local
# VIEWER_IMAGE=stocksearcher-viewer:local

# PostgreSQL host port exposed to the machine running Docker.
POSTGRES_HOST_PORT=5432

# PostgreSQL bootstrap database credentials.
# Keep POSTGRES_USER and POSTGRES_DB as airflow when reusing the old Airflow volume.
# Airflow services do not run in this Compose configuration.
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=change-me-before-start

# Credentials for the application-only stock database role and database name.
# STOCK_DB_NAME is applied only when PostgreSQL initializes an empty data volume.
# It does not rename an existing database.
STOCK_DB_USER=stock_app
STOCK_DB_PASSWORD=change-me-before-start
STOCK_DB_NAME=stock

# Host ports for the Prefect manual-run UI and the stock viewer.
PREFECT_UI_PORT=4200
VIEWER_PORT=4201

# Browser-facing Prefect API URL. Set this when the UI is opened from another machine.
# It must use the same host/IP and port as the browser-facing Prefect UI address.
# PREFECT_SERVER_UI_API_URL=http://<host-ip-or-hostname>:4200/api

# Market-data collection range passed to the existing collection scripts.
# STOCK_START_DATE=2023-01-01
# STOCK_END_DATE=2099-12-31
# STOCK_PERIOD=3

# Optional Chromium overrides. Defaults match the Linux batch image.
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Optional output and batch-state locations inside containers.
# BATCH_SOURCE_DIR=/opt/stocksearcher
# OUTPUT_DIR=/opt/stock-data
# BATCH_STATE_DIR=/var/lib/stock-batch
# BATCH_LOG_DIR=/var/lib/stock-batch/logs

# Maximum duration in seconds for one collect/daily/weekly subprocess.
# A timeout marks the task failed and terminates its Linux process group.
# BATCH_TASK_TIMEOUT_SECONDS=7200

# Prefect API address used by batch containers. Keep the Docker service address by default.
# PREFECT_API_URL=http://prefect-server:4200/api

# Prefect deployment schedules are the only scheduler. Do not configure duplicate host cron entries.
# collect: collection only (default)
# predict: daily prediction followed by weekly prediction
# full: collection followed by daily and weekly prediction
# daily: daily prediction only
# weekly: weekly prediction only
BATCH_SCHEDULE_MODE=collect

# Prefect Cron expressions: minute hour day-of-month month day-of-week.
# Time zone is fixed in each deployment schedule as Asia/Seoul.
# JP defaults to weekdays 12:00 and 18:00; KR defaults to weekdays 14:00 and 20:00.
BATCH_SCHEDULE_JP=0 12,18 * * 1-5
BATCH_SCHEDULE_KR=0 14,20 * * 1-5

# A scheduled run delayed past this value is recorded as skipped in Prefect instead of
# starting late after a Docker or Prefect restart. Set 0 to skip every delayed run.
BATCH_MAX_SCHEDULE_DELAY_SECONDS=300

# Python output is unbuffered by default so container logs are immediately visible.
# PYTHONUNBUFFERED=1
