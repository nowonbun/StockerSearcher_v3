# 자체 배치 운영 환경 예제. 복사 후 DB 비밀번호를 변경하세요. 배치 화면은 로그인 없이 로컬에서 사용합니다.
# 기존 PostgreSQL 볼륨 재사용 시 POSTGRES_USER/DB/비밀번호를 유지합니다.
# DB 초기화는 빈 볼륨에만 적용됩니다. 모델·DB 볼륨을 삭제하지 마세요.
# 예약 환경 변수는 최초 초기화에만 사용하며 이후 웹에서 저장한 설정이 우선합니다.
# 시간대 Asia/Seoul. 별도 cron이나 스케줄러를 함께 실행하지 마세요.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=airflow
POSTGRES_DB=airflow
POSTGRES_PASSWORD=change-me-before-start
STOCK_DB_USER=stock_app
STOCK_DB_PASSWORD=change-me-before-start
STOCK_DB_NAME=stock
VIEWER_PORT=4201
MCP_PORT=8000
# collect=수집+지표 자동 계산 / predict=일봉·주봉 예측 / full=수집+지표+예측
BATCH_SCHEDULE_MODE=collect
BATCH_SCHEDULE_JP=0 12,18 * * 1-5
BATCH_SCHEDULE_KR=0 14,20 * * 1-5
BATCH_MAX_SCHEDULE_DELAY_SECONDS=300

# Python 배치 관리 웹. 무인증 로컬 전용이며 외부에 공개하지 마세요.
BATCH_UI_BIND=127.0.0.1
BATCH_UI_PORT=4200
