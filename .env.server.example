# Keep these values when reusing the prior PostgreSQL volume. No Airflow service starts.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me-before-start
POSTGRES_DB=airflow
STOCK_DB_USER=stock_app
STOCK_DB_PASSWORD=change-me-before-start
PREFECT_UI_PORT=4200
VIEWER_PORT=3000

# Use the same immutable commit SHA for all images.
BATCH_IMAGE=ghcr.io/nowonbun/stockersearcher_v3-batch:sha-<commit-sha>
VIEWER_IMAGE=ghcr.io/nowonbun/stockersearcher_v3-viewer:sha-<commit-sha>
POSTGRES_IMAGE=ghcr.io/nowonbun/stockersearcher_v3-postgres:sha-<commit-sha>

# This server-local directory contains model_*.pt files and is not Git content.
MODEL_DIR=/srv/stockersearcher/models

# Prefect deployment schedules are the scheduler of record. Do not add duplicate host cron entries.
BATCH_SCHEDULE_MODE=collect
BATCH_SCHEDULE_JP=0 12,18 * * 1-5
BATCH_SCHEDULE_KR=0 14,20 * * 1-5

# Skip a Prefect scheduled run if it starts this many seconds late after a restart.
BATCH_MAX_SCHEDULE_DELAY_SECONDS=300
